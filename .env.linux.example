# Forja no Linux: cp .env.linux.example .env, troque "voce" pelo seu usuário e rode docker compose up -d --build.
# O resto das opções (limites do agente, contexto etc.) é igual ao .env.example.

# Pasta de trabalho PADRÃO (conversas sem pasta escolhida). Cada conversa pode escolher outra no topo da tela.
WORKSPACE_PATH=/home/voce/Dev/forja-workspace

# Porta da interface web no host
FORJA_PORT=7001

# Seu usuário no container (id -u / id -g): arquivos criados pelo agente ficam seus, não do root.
FORJA_UID=1000
FORJA_GID=1000
FORJA_HOME=/data/home

# Pasta visível no seletor e no shell do container. O nome HOST_DRIVE_C vem do Windows; aqui é só
# "a raiz montada em /host/c". HOST_MOUNTS traduz os caminhos: prefixo-no-seu-sistema=pasta-no-container.
HOST_DRIVE_C=/home/voce
HOST_MOUNTS=/home/voce=/host/c

# Providers no host. llama-server (llama.cpp) também serve aqui: ele fala a API OpenAI, então aponte
# LMSTUDIO_URL para ele (ex.: http://host.docker.internal:8080/v1).
OLLAMA_URL=http://host.docker.internal:11434/v1
LMSTUDIO_URL=http://host.docker.internal:1234/v1

# forja-runner: comandos e servidores no SEU sistema (tools/forja-runner.service). Vazio = sempre no container.
FORJA_RUNNER_URL=http://host.docker.internal:3002

# Pasta do Windows que o agente pode ler/escrever (montada em /workspace no container)
WORKSPACE_PATH=C:/Users/pedro/Dev/forja-workspace

# Porta da interface web no host
FORJA_PORT=3000

# Endpoints dos providers (rodando no host, fora do Docker)
OLLAMA_URL=http://host.docker.internal:11434/v1
LMSTUDIO_URL=http://host.docker.internal:1234/v1

# Janela de contexto enviada ao Ollama (options.num_ctx). O padrão do Ollama (4k) trunca as ferramentas.
NUM_CTX=32768

# Limites do agente
MAX_ITERATIONS=25
MAX_FILE_BYTES=1000000

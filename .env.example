# Pasta de trabalho PADRÃO (conversas sem pasta escolhida). Cada conversa pode escolher outra no topo da tela.
WORKSPACE_PATH=C:/Users/pedro/Dev/forja-workspace

# Porta da interface web no host
FORJA_PORT=7001

# Endpoints dos providers (rodando no host, fora do Docker)
OLLAMA_URL=http://host.docker.internal:11434/v1
LMSTUDIO_URL=http://host.docker.internal:1234/v1

# Janela de contexto enviada ao Ollama (options.num_ctx). O padrão do Ollama (4k) trunca as ferramentas.
NUM_CTX=32768

# Limites do agente
MAX_ITERATIONS=25
MAX_FILE_BYTES=1000000

# Entrega 2
# Teto (segundos) do run_command
SHELL_TIMEOUT_MAX=300
# Compacta o contexto quando o prompt passa desta fração da janela
COMPACT_AT=0.8

# Entrega 4: discos do Windows para o seletor de pasta de trabalho (montados em /host/<letra>)
HOST_DRIVE_C=C:/
HOST_MOUNTS=C=/host/c

# forja-runner: executa comandos e servidores no SEU sistema (tools/forja_runner.py). Vazio = sempre no container.
FORJA_RUNNER_URL=http://host.docker.internal:3002

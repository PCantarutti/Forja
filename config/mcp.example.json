{
  "mcpServers": {
    "memoria": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "tempo": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=America/Sao_Paulo"]
    },
    "remoto-exemplo": {
      "url": "http://host.docker.internal:8931/mcp",
      "disabled": true
    }
  }
}
